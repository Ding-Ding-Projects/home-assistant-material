<!DOCTYPE html>
<html>
  <head>
    <title>Home Assistant</title>
    <% if (useCacheRecovery) { %><%= renderTemplate("_bootstrap_recovery.html.template") %><% } %>
    <%= renderTemplate("_header.html.template") %>
    <link rel="mask-icon" href="/static/icons/mask-icon.svg" color="#18bcf2" />
    <link
      rel="apple-touch-icon"
      href="/static/icons/favicon-apple-180x180.png"
    />
    <meta name="apple-itunes-app" content="app-id=1099568401" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default">
    <meta name="apple-mobile-web-app-title" content="Home Assistant">
    <meta name="msapplication-config" content="/static/icons/browserconfig.xml" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="application-name" content="Home Assistant">
    <meta name="referrer" content="same-origin" />
    <meta name="theme-color" content="{{ theme_color }}" />
    <meta name="color-scheme" content="dark light" />
    <%= renderTemplate("_style_base.html.template") %>
    <style>
      html {
        background-color: var(--primary-background-color, #fafafa);
        color: var(--primary-text-color, #212121);
        height: 100vh;
      }
      @media (prefers-color-scheme: dark) {
        html {
          background-color: var(--primary-background-color, #111111);
          color: var(--primary-text-color, #e1e1e1);
        }
      }
      #ha-launch-screen-name {
        margin-top: 16px;
        max-width: 90vw;
        text-align: center;
        overflow-wrap: anywhere;
        font-size: 20px;
        color: var(--secondary-text-color, #727272);
      }
      #ha-launch-screen-name:empty {
        display: none;
      }
    </style>
    <%= renderTemplate("_style_launch_screen.html.template") %>
  </head>
  <body>
    <div id="ha-launch-screen">
      <div class="ha-launch-screen-spacer-top"></div>
      <div class="ha-lockup">
        <img class="ha-logo" src="/static/images/home-assistant-logo-loading.svg" alt="Home Assistant">
      </div>
      <div id="ha-launch-screen-name"></div>
      <div id="ha-launch-screen-info-box" class="ha-launch-screen-spacer-bottom"></div>
    </div>
    <script>
      // Shows the name this browser chose for the app, as plain text. Any
      // problem leaves the launch screen as it is. Not transpiled: ES5.
      try {
        // The name in effect last time, including one stored for everyone.
        var cachedName = window.localStorage.getItem("ha-material-identity-launch");
        var storedIdentity = window.localStorage.getItem("ha-material-identity");
        var chosen = storedIdentity ? JSON.parse(storedIdentity) : null;
        var rawName = typeof cachedName === "string" && cachedName ? cachedName : chosen && typeof chosen.name === "string" ? chosen.name : "";
        if (rawName) {
          var launchName = rawName.replace(/[\u0000-\u001f\u007f]+/g, " ").replace(/\s+/g, " ").replace(/^ | $/g, "").slice(0, 40);
          if (launchName) {
            document.getElementById("ha-launch-screen-name").textContent = launchName;
          }
        }
      } catch (e) {}
    </script>
    <home-assistant></home-assistant>
    <%= renderTemplate("_js_base.html.template") %>
    <%= renderTemplate("_preload_roboto.html.template") %>
    <script crossorigin="use-credentials">
      if (isModern) {
        <% for (const entry of latestEntryJS) { %>
          import("<%= entry %>");
        <% } %>
        window.customPanelJS = "<%= latestCustomPanelJS %>";
        window.latestJS = true;
      }
    </script>
    <script>
        if (!window.latestJS) {
          // Floor check: BigInt for Chrome 67, <dialog> for Safari 15.4 and
          // Firefox 98. Not transpiled, so keep this ES5.
          (function () {
            var ACCEPTED_KEY = "haUnsupportedBrowserAccepted";
            var REMIND_AFTER = 30 * 24 * 60 * 60 * 1000;

            function loadApp() {
              window.customPanelJS = "<%= es5CustomPanelJS %>";
              <% for (const entry of es5EntryJS) { %>
                _ls("<%= entry %>", true);
              <% } %>
            }

            if (
              typeof BigInt !== "undefined" &&
              typeof document.createElement("dialog").showModal === "function"
            ) {
              loadApp();
              return;
            }

            // Shown while the app loads too.
            var box = document.getElementById("ha-launch-screen-info-box");
            var message = document.createElement("p");
            message.textContent =
              "This browser is no longer supported. Some parts of Home Assistant may not work.";
            box.appendChild(message);

            // Stored: "always", or when the user last continued (ms).
            var stored = null;
            try {
              stored = localStorage.getItem(ACCEPTED_KEY);
            } catch (_err) {
              // Ask on every load.
            }
            if (stored === "always") {
              loadApp();
              return;
            }
            var acceptedAt = Number(stored) || 0;
            // A clock behind the stored time asks again.
            var age = Date.now() - acceptedAt;
            if (acceptedAt && age >= 0 && age < REMIND_AFTER) {
              loadApp();
              return;
            }

            var actions = document.createElement("div");
            actions.className = "ha-launch-screen-actions";
            box.appendChild(actions);

            var always = null;
            var button = document.createElement("button");
            button.type = "button";
            button.textContent = "Continue anyway";
            button.addEventListener("click", function () {
              try {
                localStorage.setItem(
                  ACCEPTED_KEY,
                  always && always.checked ? "always" : String(Date.now())
                );
              } catch (_err) {
                // Continue this time only.
              }
              box.removeChild(actions);
              loadApp();
            });
            actions.appendChild(button);

            // From the first reminder on. A checkbox, so it is not chosen by
            // accident.
            if (acceptedAt) {
              var label = document.createElement("label");
              always = document.createElement("input");
              always.type = "checkbox";
              label.appendChild(always);
              label.appendChild(document.createTextNode("Don't show again"));
              actions.appendChild(label);
            }
          })();
        }
    </script>

    <% if (obj.hassUrl === "") { %>
      <script>
        // The app entry calls this right after it installs the scoped custom
        // element registry polyfill, so extra modules define their elements in
        // the registry that the app uses.
        window.__haLoadExtraModules = function () {
          {%- for extra_module in extra_modules -%}
          // Caught, or the boot recovery guard reads it as a stale build.
          import("{{ extra_module }}").catch(function (err) {
            console.error("Failed to load extra module {{ extra_module }}", err);
          });
          {%- endfor -%}
          if (!window.latestJS) {
            {%- for extra_script in extra_js_es5 -%}
            _ls("{{ extra_script }}");
            {%- endfor -%}
          }
        };
        if (window.__haScopedRegistryReady) {
          window.__haLoadExtraModules();
        }
      </script>
    <% } %>
  </body>
</html>
