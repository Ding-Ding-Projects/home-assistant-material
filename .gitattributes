# Shell scripts must keep LF so they run inside containers when checked out on Windows.
*.sh text eol=lf
*.py text eol=lf
*.Dockerfile text eol=lf
# Batch files must keep CRLF so cmd.exe parses labels correctly.
*.bat text eol=crlf

# Fonts and pictures are never text.
*.woff2 binary
*.png binary
*.jpg binary
