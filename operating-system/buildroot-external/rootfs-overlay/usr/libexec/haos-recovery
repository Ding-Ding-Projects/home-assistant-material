#!/bin/sh
#
# haos-recovery: act on a request file found on a USB stick labelled HA-RECOVERY.
#
# This script is started by haos-recovery.service, and only when a block device
# with the label HA-RECOVERY appears. It never runs otherwise.
#
# Design rules (see docs/features/hosting/usb-recovery.md):
#   * Nothing happens without a valid, explicit request file in the stick root.
#   * One shot: the request is renamed to "started" before any action, then to
#     "done" or "failed". A stick holding any such marker is never acted on again.
#   * Never executes or sources anything from the stick.
#   * Every failure path logs and exits with status 0, so a boot is never held up.
#   * No second implementation of deletion: factory-reset sets the flag that
#     haos-wipe consumes, reset-apps creates the trigger that haos-docker-reset
#     consumes, reinstall-os calls rauc, which verifies the signature.
#
# Every command and path can be overridden through the environment so the script
# can be tested against ordinary temporary files.

# Deliberately no "set -e": each failure is handled and logged explicitly.

RECOVERY_DEV="${RECOVERY_DEV:-/dev/disk/by-label/HA-RECOVERY}"
RECOVERY_DEV_TEST="${RECOVERY_DEV_TEST:--b}"
RECOVERY_MNT="${RECOVERY_MNT:-/run/haos-recovery/stick}"
RECOVERY_FSTYPES="${RECOVERY_FSTYPES:-vfat,exfat,ext4}"
RAUC_BIN="${RAUC_BIN:-rauc}"
RAUC_WAIT="${RAUC_WAIT:-120}"
BOOT_DIR="${BOOT_DIR:-/mnt/boot}"
DATA_DIR="${DATA_DIR:-/mnt/data}"
OS_RELEASE="${OS_RELEASE:-/usr/lib/os-release}"
CMDLINE_FILE="${CMDLINE_FILE:-/proc/cmdline}"
REBOOT_CMD="${REBOOT_CMD:-systemctl --no-block reboot}"
MOUNT_CMD="${MOUNT_CMD:-mount}"
UMOUNT_CMD="${UMOUNT_CMD:-umount}"
MOUNTPOINT_CMD="${MOUNTPOINT_CMD:-mountpoint -q}"
JQ_BIN="${JQ_BIN:-jq}"
LED_DIR="${LED_DIR:-/sys/class/leds}"
LED_HOLD="${LED_HOLD:-20}"
NOW="${NOW:-}"

REQUEST_NAME="recovery-request.json"
RESULT_NAME="recovery-result.txt"
MAX_REQUEST_BYTES=4096
MAX_RESULT_BYTES=1048576

MOUNTED=0
RESULT_OK=0
STATE_FILE=""
STARTED=0
FINISHED=0
WANT_REBOOT=0
LED_PATH=""
LED_OLD_TRIGGER=""
LED_PID=""
TS=""

say() {
    echo "[recovery] $*"
}

timestamp() {
    if [ -n "${NOW}" ]; then
        echo "${NOW}"
    else
        date -u +%Y%m%dT%H%M%SZ
    fi
}

human_time() {
    # 20261116T130500Z -> 2026-11-16 13:05:00 UTC (24-hour)
    timestamp | sed -E 's/^([0-9]{4})([0-9]{2})([0-9]{2})T([0-9]{2})([0-9]{2})([0-9]{2})Z$/\1-\2-\3 \4:\5:\6 UTC/'
}

# Console line plus, when the stick is writable, a line in the result file.
rlog() {
    say "$*"
    if [ "${RESULT_OK}" = "1" ]; then
        printf '%s  %s\n' "$(human_time)" "$*" >> "${RECOVERY_MNT}/${RESULT_NAME}" 2> /dev/null || true
    fi
}

# ---------------------------------------------------------------------------
# LED status (best effort; skipped when no user-space controllable LED exists)
# ---------------------------------------------------------------------------

led_find() {
    [ -d "${LED_DIR}" ] || return 1
    for name in ACT led0 led-act; do
        if [ -w "${LED_DIR}/${name}/brightness" ]; then
            LED_PATH="${LED_DIR}/${name}"
            return 0
        fi
    done
    for dir in "${LED_DIR}"/*; do
        [ -w "${dir}/brightness" ] || continue
        case "${dir}" in
            *activity* | *green* | *status*)
                LED_PATH="${dir}"
                return 0
                ;;
        esac
    done
    return 1
}

led_setup() {
    led_find || return 0
    if [ -r "${LED_PATH}/trigger" ]; then
        LED_OLD_TRIGGER=$(sed -n 's/.*\[\([^]]*\)\].*/\1/p' "${LED_PATH}/trigger" 2> /dev/null)
        echo none > "${LED_PATH}/trigger" 2> /dev/null || true
    fi
}

led_sleep() {
    sleep "$1" 2> /dev/null || sleep 1
}

# led_pattern <on-seconds> <off-seconds> <count>; count 0 means forever.
led_pattern_run() {
    on="$1"
    off="$2"
    count="$3"
    i=0
    while [ "${count}" = "0" ] || [ "${i}" -lt "${count}" ]; do
        echo 1 > "${LED_PATH}/brightness" 2> /dev/null
        led_sleep "${on}"
        echo 0 > "${LED_PATH}/brightness" 2> /dev/null
        led_sleep "${off}"
        i=$((i + 1))
    done
}

led_stop() {
    if [ -n "${LED_PID}" ]; then
        kill "${LED_PID}" 2> /dev/null || true
        wait "${LED_PID}" 2> /dev/null || true
        LED_PID=""
    fi
}

# led_start <on> <off> <count>
led_start() {
    [ -n "${LED_PATH}" ] || return 0
    led_stop
    led_pattern_run "$@" &
    LED_PID=$!
}

led_release() {
    [ -n "${LED_PATH}" ] || return 0
    led_stop
    echo 0 > "${LED_PATH}/brightness" 2> /dev/null || true
    if [ -n "${LED_OLD_TRIGGER}" ]; then
        echo "${LED_OLD_TRIGGER}" > "${LED_PATH}/trigger" 2> /dev/null || true
    fi
    LED_PATH=""
}

# Working: fast blink. Done: slow, even blink. Failed: rapid bursts.
led_working() { led_start 0.2 0.2 0; }
led_done() { led_start 1 1 0; }
led_failed() { led_start 0.1 0.1 0; }

led_hold() {
    [ -n "${LED_PATH}" ] || return 0
    case "${LED_HOLD}" in
        '' | *[!0-9]*) return 0 ;;
    esac
    [ "${LED_HOLD}" -gt 0 ] && sleep "${LED_HOLD}"
}

# ---------------------------------------------------------------------------
# Cleanup and state handling
# ---------------------------------------------------------------------------

cleanup() {
    led_release
    if [ "${MOUNTED}" = "1" ]; then
        sync
        if ${UMOUNT_CMD} "${RECOVERY_MNT}" > /dev/null 2>&1; then
            say "Stick unmounted"
        else
            say "Could not unmount the stick cleanly; it was synced"
        fi
        MOUNTED=0
        RESULT_OK=0
    fi
}

# Move the request marker to its final state.
finish_request() {
    outcome="$1"
    if [ "${STARTED}" = "1" ] && [ "${FINISHED}" = "0" ]; then
        final="${RECOVERY_MNT}/recovery-request.${outcome}-${TS}.json"
        if mv "${STATE_FILE}" "${final}" 2> /dev/null; then
            STATE_FILE="${final}"
        else
            rlog "Could not rename the request marker to ${outcome}"
        fi
        FINISHED=1
    fi
}

# shellcheck disable=SC2329 # invoked through trap
on_signal() {
    rlog "Interrupted before the action finished"
    finish_request failed
    led_failed
    cleanup
    exit 0
}

fail() {
    # A refused request: nothing was changed, the request stays untouched.
    rlog "Refused: $*"
    led_failed
    led_hold
    cleanup
    exit 0
}

action_failed() {
    rlog "FAILED: $*"
    finish_request failed
    led_failed
    rlog "Result: failed. Nothing further was changed."
    led_hold
    cleanup
    exit 0
}

action_done() {
    rlog "$*"
    finish_request "done"
    rlog "Result: done."
    led_done
}

# ---------------------------------------------------------------------------
# Device facts
# ---------------------------------------------------------------------------

os_value() {
    sed -n "s/^$1=//p" "${OS_RELEASE}" 2> /dev/null | head -n 1 | tr -d '"'
}

running_slot() {
    sed -n 's/.*rauc\.slot=\([^ ]*\).*/\1/p' "${CMDLINE_FILE}" 2> /dev/null | head -n 1
}

# Prints lt, eq or gt: $1 compared with $2 (dotted numeric versions).
version_cmp() {
    awk -v a="$1" -v b="$2" 'BEGIN {
        na = split(a, x, "."); nb = split(b, y, ".")
        n = (na > nb) ? na : nb
        for (i = 1; i <= n; i++) {
            xi = (i <= na) ? x[i] + 0 : 0
            yi = (i <= nb) ? y[i] + 0 : 0
            if (xi < yi) { print "lt"; exit }
            if (xi > yi) { print "gt"; exit }
        }
        print "eq"
    }'
}

# ---------------------------------------------------------------------------
# Request validation
# ---------------------------------------------------------------------------

# Prints "OK" or a short reason. Never prints request content.
# shellcheck disable=SC2016 # the jq program is intentionally single-quoted
validate_request_shape() {
    "${JQ_BIN}" -r '
        def keys_ok: (keys - ["format", "action", "confirm", "bundle", "minimum_version"]) | length == 0;
        if type != "object" then "the request is not a JSON object"
        elif (keys_ok | not) then "the request contains an unknown key"
        elif (has("format") | not) or (.format != 1) or ((.format | type) != "number") then "format must be the number 1"
        elif (has("action") | not) or ((.action | type) != "string") then "action must be a string"
        elif ((.action) as $a | ["reinstall-os", "reset-apps", "factory-reset"] | index($a)) == null then "unknown action"
        elif (has("confirm") | not) or ((.confirm | type) != "string") then "confirm must be a string"
        elif has("bundle") and ((.bundle | type) != "string") then "bundle must be a string"
        elif (.action == "reinstall-os") and (has("bundle") | not) then "reinstall-os needs a bundle file name"
        elif (.action != "reinstall-os") and has("bundle") then "bundle is only allowed for reinstall-os"
        elif has("minimum_version") and (((.minimum_version | type) != "string") or ((.minimum_version | test("^[0-9]+\\.[0-9]+(\\.[0-9]+)?$")) | not)) then "minimum_version must look like 17.0 or 17.0.1"
        else "OK" end
    ' "$1" 2> /dev/null
}

confirm_phrase() {
    case "$1" in
        reinstall-os) echo "REINSTALL-OS" ;;
        reset-apps) echo "RESET-APPS" ;;
        factory-reset) echo "ERASE-EVERYTHING-ON-THIS-DEVICE" ;;
    esac
}

# Inspect the stick root. Sets REQUEST_REAL_NAME, or returns 1 with REASON.
find_request() {
    REQUEST_REAL_NAME=""
    REASON=""
    pending=0
    used=0
    other=0
    for entry in "${RECOVERY_MNT}"/* "${RECOVERY_MNT}"/.[!.]*; do
        [ -e "${entry}" ] || [ -L "${entry}" ] || continue
        base="${entry##*/}"
        lower=$(printf '%s' "${base}" | tr '[:upper:]' '[:lower:]')
        case "${lower}" in
            "${REQUEST_NAME}")
                pending=$((pending + 1))
                REQUEST_REAL_NAME="${base}"
                ;;
            recovery-request.started-*.json | recovery-request.done-*.json | recovery-request.failed-*.json)
                used=$((used + 1))
                ;;
            recovery-request*)
                other=$((other + 1))
                ;;
        esac
    done
    if [ "${used}" -gt 0 ]; then
        REASON="used"
        return 1
    fi
    if [ "${pending}" -eq 0 ] && [ "${other}" -eq 0 ]; then
        REASON="none"
        return 1
    fi
    if [ "${pending}" -ne 1 ] || [ "${other}" -gt 0 ]; then
        REASON="more than one request file is present"
        return 1
    fi
    return 0
}

# ---------------------------------------------------------------------------
# Actions
# ---------------------------------------------------------------------------

wait_for_rauc() {
    waited=0
    while ! ${RAUC_BIN} status > /dev/null 2>&1; do
        if [ "${waited}" -ge "${RAUC_WAIT}" ]; then
            return 1
        fi
        sleep 2
        waited=$((waited + 2))
    done
    return 0
}

do_reinstall_os() {
    bundle_path="${RECOVERY_MNT}/${BUNDLE_NAME}"
    rlog "Step 1/3: waiting for the update service"
    if ! wait_for_rauc; then
        action_failed "the update service (rauc) did not become ready; nothing was installed"
    fi
    rlog "Step 2/3: installing ${BUNDLE_NAME}; the signature is verified by rauc and this can take several minutes"
    if ${RAUC_BIN} install "${bundle_path}"; then
        rlog "Step 3/3: install finished; the new system copy is selected for the next start"
        WANT_REBOOT=1
        action_done "Operating system reinstalled from ${BUNDLE_NAME}. The device restarts after this result is saved."
    else
        action_failed "rauc rejected or could not install the bundle; no restart was requested"
    fi
}

do_reset_apps() {
    rlog "Step 1/2: checking that the data partition is mounted"
    if ! ${MOUNTPOINT_CMD} "${DATA_DIR}" > /dev/null 2>&1; then
        action_failed "the data partition is not mounted, so the app storage reset cannot be scheduled; use factory-reset if the device is beyond repair"
    fi
    rlog "Step 2/2: scheduling the existing app storage reset for the next start"
    if mkdir -p "${DATA_DIR}/docker" && : > "${DATA_DIR}/docker/.wipe-scheduled"; then
        sync
        WANT_REBOOT=1
        action_done "App storage reset scheduled. Settings and the Home Assistant configuration are kept. The device restarts after this result is saved."
    else
        action_failed "could not create the reset trigger on the data partition"
    fi
}

do_factory_reset() {
    cmdline="${BOOT_DIR}/cmdline.txt"
    rlog "Step 1/2: checking the boot partition"
    if ! ${MOUNTPOINT_CMD} "${BOOT_DIR}" > /dev/null 2>&1; then
        action_failed "the boot partition is not mounted"
    fi
    if [ ! -f "${cmdline}" ]; then
        action_failed "this board has no cmdline.txt, so the erase flag cannot be set from the recovery stick"
    fi
    rlog "Step 2/2: setting the existing erase flag; the next start erases the data and overlay partitions"
    if grep -q 'haos\.wipe=1' "${cmdline}" 2> /dev/null; then
        rlog "The erase flag was already set"
    else
        if ! sed -i '1s/[[:space:]]*$/ haos.wipe=1/' "${cmdline}"; then
            action_failed "could not update cmdline.txt"
        fi
    fi
    if ! grep -q 'haos\.wipe=1' "${cmdline}" 2> /dev/null; then
        action_failed "the erase flag could not be confirmed in cmdline.txt"
    fi
    sync
    WANT_REBOOT=1
    action_done "EVERYTHING ON THIS DEVICE WILL BE ERASED on the next start: all settings, add-ons, history and the Home Assistant configuration. The device restarts after this result is saved."
}

# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------

main() {
    TS=$(timestamp)
    trap on_signal TERM HUP INT
    trap cleanup EXIT

    say "USB recovery stick detected"

    if ! command -v "${JQ_BIN}" > /dev/null 2>&1; then
        say "jq is not available; doing nothing"
        exit 0
    fi
    dev_ok=1
    case "${RECOVERY_DEV_TEST}" in
        -b) [ -b "${RECOVERY_DEV}" ] || dev_ok=0 ;;
        *) [ -e "${RECOVERY_DEV}" ] || dev_ok=0 ;;
    esac
    if [ "${dev_ok}" != "1" ]; then
        say "Recovery device ${RECOVERY_DEV} is not usable; doing nothing"
        exit 0
    fi
    if command -v findmnt > /dev/null 2>&1 && findmnt "${RECOVERY_DEV}" > /dev/null 2>&1 \
        && [ "${MOUNT_CMD}" = "mount" ]; then
        say "Recovery device is already mounted elsewhere; doing nothing"
        exit 0
    fi

    mkdir -p "${RECOVERY_MNT}" 2> /dev/null
    if ! ${MOUNT_CMD} -t "${RECOVERY_FSTYPES}" -o rw,nosuid,nodev,noexec,sync \
        "${RECOVERY_DEV}" "${RECOVERY_MNT}" > /dev/null 2>&1; then
        say "Could not mount the stick (supported: ${RECOVERY_FSTYPES}); doing nothing"
        exit 0
    fi
    MOUNTED=1

    # The stick must be writable, otherwise the one-shot marker cannot be kept.
    result_size=0
    if [ -f "${RECOVERY_MNT}/${RESULT_NAME}" ]; then
        result_size=$(wc -c < "${RECOVERY_MNT}/${RESULT_NAME}" 2> /dev/null || echo 0)
    fi
    if [ "${result_size}" -le "${MAX_RESULT_BYTES}" ] 2> /dev/null; then
        if : >> "${RECOVERY_MNT}/${RESULT_NAME}" 2> /dev/null; then
            RESULT_OK=1
        fi
    fi
    if [ "${RESULT_OK}" != "1" ]; then
        say "The stick is read-only or its result file is unusable; doing nothing"
        exit 0
    fi

    led_setup

    if ! find_request; then
        case "${REASON}" in
            none)
                say "No request file on the stick; doing nothing"
                ;;
            used)
                say "This stick already carries a started, done or failed request; doing nothing"
                ;;
            *)
                rlog "Refused: ${REASON}"
                ;;
        esac
        exit 0
    fi

    rlog "Request file found; board $(os_value VARIANT_ID), OS version $(os_value VERSION_ID), system slot $(running_slot)"

    request_path="${RECOVERY_MNT}/${REQUEST_REAL_NAME}"
    if [ "${REQUEST_REAL_NAME}" != "${REQUEST_NAME}" ]; then
        fail "the request file name must be exactly ${REQUEST_NAME}"
    fi
    if [ -L "${request_path}" ] || [ ! -f "${request_path}" ]; then
        fail "the request file must be a regular file, not a link"
    fi
    request_size=$(wc -c < "${request_path}" 2> /dev/null || echo 0)
    if [ "${request_size}" -gt "${MAX_REQUEST_BYTES}" ] 2> /dev/null; then
        fail "the request file is larger than ${MAX_REQUEST_BYTES} bytes"
    fi

    shape=$(validate_request_shape "${request_path}")
    if [ "${shape}" != "OK" ]; then
        fail "${shape:-the request is not valid JSON}"
    fi

    ACTION=$("${JQ_BIN}" -r '.action' "${request_path}")
    CONFIRM=$("${JQ_BIN}" -r '.confirm' "${request_path}")
    expected=$(confirm_phrase "${ACTION}")
    if [ -z "${expected}" ] || [ "${CONFIRM}" != "${expected}" ]; then
        fail "the confirm phrase does not match the action"
    fi

    BUNDLE_NAME=""
    if [ "${ACTION}" = "reinstall-os" ]; then
        BUNDLE_NAME=$("${JQ_BIN}" -r '.bundle' "${request_path}")
        MIN_VERSION=$("${JQ_BIN}" -r '.minimum_version // empty' "${request_path}")
        if ! printf '%s' "${BUNDLE_NAME}" | grep -Eq '^haos_[a-z0-9-]+-[0-9]+\.[0-9]+(\.[0-9]+)?\.raucb$'; then
            fail "the bundle file name is not an expected update file name"
        fi
        bundle_board=$(printf '%s' "${BUNDLE_NAME}" | sed -E 's/^haos_([a-z0-9-]+)-[0-9]+\.[0-9]+(\.[0-9]+)?\.raucb$/\1/')
        bundle_version=$(printf '%s' "${BUNDLE_NAME}" | sed -E 's/^haos_[a-z0-9-]+-([0-9]+\.[0-9]+(\.[0-9]+)?)\.raucb$/\1/')
        device_board=$(os_value VARIANT_ID)
        if [ -z "${device_board}" ] || [ "${bundle_board}" != "${device_board}" ]; then
            fail "the bundle is for board '${bundle_board}', this device is '${device_board}'"
        fi
        if [ -L "${RECOVERY_MNT}/${BUNDLE_NAME}" ] || [ ! -f "${RECOVERY_MNT}/${BUNDLE_NAME}" ]; then
            fail "the bundle file is missing from the stick root or is not a regular file"
        fi
        if [ ! -s "${RECOVERY_MNT}/${BUNDLE_NAME}" ]; then
            fail "the bundle file is empty"
        fi
        running_version=$(os_value VERSION_ID | sed -nE 's/^([0-9]+\.[0-9]+(\.[0-9]+)?).*/\1/p')
        if [ -z "${running_version}" ]; then
            fail "the running OS version could not be read"
        fi
        if [ "$(version_cmp "${bundle_version}" "${running_version}")" = "lt" ]; then
            fail "the bundle version ${bundle_version} is older than the running version ${running_version}; downgrades are not done from this stick"
        fi
        if [ -n "${MIN_VERSION}" ] && [ "$(version_cmp "${bundle_version}" "${MIN_VERSION}")" = "lt" ]; then
            fail "the bundle version ${bundle_version} is older than the requested minimum ${MIN_VERSION}"
        fi
    fi

    # One shot: mark the request as started before anything is changed.
    STATE_FILE="${RECOVERY_MNT}/recovery-request.started-${TS}.json"
    if ! mv "${request_path}" "${STATE_FILE}" 2> /dev/null; then
        STATE_FILE=""
        fail "could not mark the request as started, so the one-shot rule cannot be kept"
    fi
    STARTED=1
    sync
    rlog "Action ${ACTION} started (request renamed to started-${TS})"
    led_working

    case "${ACTION}" in
        reinstall-os) do_reinstall_os ;;
        reset-apps) do_reset_apps ;;
        factory-reset) do_factory_reset ;;
    esac

    led_hold
    cleanup
    if [ "${WANT_REBOOT}" = "1" ]; then
        say "Requesting restart"
        ${REBOOT_CMD}
    fi
    exit 0
}

main "$@"
